<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="asv_field">
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>

    <!-- White ground plane: 60 m long x 30 m wide. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 30</size>
            </plane>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <ambient>1 1 1 1</ambient>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Brown perimeter walls for the two adjacent fields. The wall at x=0
         is shared by both fields and is defined only once. -->
    <model name="field_walls">
      <static>true</static>
      <link name="walls_link">
        <visual name="wall_top">
          <pose>0 14.75 0.60 0 0 0</pose>
          <geometry><box><size>60 0.50 1.20</size></box></geometry>
          <material><diffuse>0.45 0.20 0.06 1</diffuse><ambient>0.14 0.05 0.01 1</ambient></material>
        </visual>
        <collision name="wall_top_collision">
          <pose>0 14.75 0.60 0 0 0</pose>
          <geometry><box><size>60 0.50 1.20</size></box></geometry>
        </collision>

        <visual name="wall_bottom">
          <pose>0 -14.75 0.60 0 0 0</pose>
          <geometry><box><size>60 0.50 1.20</size></box></geometry>
          <material><diffuse>0.45 0.20 0.06 1</diffuse><ambient>0.14 0.05 0.01 1</ambient></material>
        </visual>
        <collision name="wall_bottom_collision">
          <pose>0 -14.75 0.60 0 0 0</pose>
          <geometry><box><size>60 0.50 1.20</size></box></geometry>
        </collision>

        <visual name="wall_left_outer">
          <pose>-29.75 0 0.60 0 0 0</pose>
          <geometry><box><size>0.50 30 1.20</size></box></geometry>
          <material><diffuse>0.45 0.20 0.06 1</diffuse><ambient>0.14 0.05 0.01 1</ambient></material>
        </visual>
        <collision name="wall_left_outer_collision">
          <pose>-29.75 0 0.60 0 0 0</pose>
          <geometry><box><size>0.50 30 1.20</size></box></geometry>
        </collision>

        <!-- One shared divider; do not duplicate it for the two fields. -->
        <visual name="wall_center_shared">
          <pose>0 0 0.60 0 0 0</pose>
          <geometry><box><size>0.50 30 1.20</size></box></geometry>
          <material><diffuse>0.45 0.20 0.06 1</diffuse><ambient>0.14 0.05 0.01 1</ambient></material>
        </visual>
        <collision name="wall_center_shared_collision">
          <pose>0 0 0.60 0 0 0</pose>
          <geometry><box><size>0.50 30 1.20</size></box></geometry>
        </collision>

        <visual name="wall_right_outer">
          <pose>29.75 0 0.60 0 0 0</pose>
          <geometry><box><size>0.50 30 1.20</size></box></geometry>
          <material><diffuse>0.45 0.20 0.06 1</diffuse><ambient>0.14 0.05 0.01 1</ambient></material>
        </visual>
        <collision name="wall_right_outer_collision">
          <pose>29.75 0 0.60 0 0 0</pose>
          <geometry><box><size>0.50 30 1.20</size></box></geometry>
        </collision>
      </link>
    </model>

    <!--
      Physical objects that follow the markers in gambar_lapangan.png.
      The reference image is kept in images/ for documentation only. All
      objects are static and use the same x/y mapping as that reference.
    -->
    <model name="field_boxes">
      <static>true</static>
      <link name="boxes_link">
