<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="asv_field">
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>

    <!-- Ground plane: 60 m long x 30 m wide. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 30</size>
            </plane>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Field image, raised by 1 mm to avoid z-fighting with the ground. -->
    <model name="field_image">
      <static>true</static>
      <link name="field_image_link">
        <visual name="field_image_visual">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 30</size>
            </plane>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <!-- Gazebo Harmonic / Gazebo Sim material. -->
            <pbr>
              <metal>
                <albedo_map>file:///home/ekonawa/workspace/asv_mobile_robot/images/gambar_lapangan.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>1.0</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>
  </world>
</sdf>
