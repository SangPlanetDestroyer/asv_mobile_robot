<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="asv_field">
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>

    <!-- Ground plane: 60 m long x 30 m wide. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 30</size>
            </plane>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Field image, raised by 1 mm to avoid z-fighting with the ground. -->
    <model name="field_image">
      <static>true</static>
      <link name="field_image_link">
        <visual name="field_image_visual">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 30</size>
            </plane>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <!-- Gazebo Harmonic / Gazebo Sim material. -->
            <pbr>
              <metal>
                <albedo_map>file:///home/ekonawa/workspace/asv_mobile_robot/images/gambar_lapangan.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>1.0</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Physical objects that follow the markers in gambar_lapangan.png.
      The image is mapped over x=[-30, 30] and y=[-15, 15], with its
      horizontal centre at the world origin. All objects are static so
      their positions stay aligned with the reference image.
    -->
    <model name="field_boxes">
      <static>true</static>
      <link name="boxes_link">
        <!-- Horizontal blue box, left lane. -->
        <visual name="box_blue_left_outer">
          <pose>-24.85 -8.78 0.31 0 0 0</pose>
          <geometry><box><size>1.55 0.80 0.60</size></box></geometry>
          <material><diffuse>0.05 0.25 0.95 1</diffuse><ambient>0.02 0.08 0.30 1</ambient></material>
        </visual>
        <collision name="box_blue_left_outer_collision">
          <pose>-24.85 -8.78 0.31 0 0 0</pose>
          <geometry><box><size>1.55 0.80 0.60</size></box></geometry>
        </collision>

        <!-- Horizontal green box, left lane. -->
        <visual name="box_green_left_inner">
          <pose>-22.05 -12.08 0.31 0 0 0</pose>
          <geometry><box><size>1.35 0.75 0.60</size></box></geometry>
          <material><diffuse>0.10 0.80 0.20 1</diffuse><ambient>0.03 0.25 0.05 1</ambient></material>
        </visual>
        <collision name="box_green_left_inner_collision">
          <pose>-22.05 -12.08 0.31 0 0 0</pose>
          <geometry><box><size>1.35 0.75 0.60</size></box></geometry>
        </collision>

        <!-- Vertical blue box near the inner end of the left lane. -->
        <visual name="box_blue_left_inner_end">
          <pose>-4.70 -11.82 0.31 0 0 0</pose>
          <geometry><box><size>0.80 1.65 0.60</size></box></geometry>
          <material><diffuse>0.05 0.25 0.95 1</diffuse><ambient>0.02 0.08 0.30 1</ambient></material>
        </visual>
        <collision name="box_blue_left_inner_end_collision">
          <pose>-4.70 -11.82 0.31 0 0 0</pose>
          <geometry><box><size>0.80 1.65 0.60</size></box></geometry>
        </collision>

        <!-- Mirrored boxes for the right lane. -->
